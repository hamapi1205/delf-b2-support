# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# トレンド自動取得(Reddit)
# 形式: "subreddit名:カテゴリ" をカンマ区切り。カテゴリ省略時は other
REDDIT_SUBREDDITS=ChatGPT:ai,artificial:ai,InternetIsBeautiful:app
# このupvote数未満の投稿は取り込まない
REDDIT_MIN_SCORE=200
# 自動取得時にAI分析まで実行する最大件数(OpenAIコスト管理)
AUTO_ANALYZE_LIMIT=3
# Vercel Cron の認証用シークレット(ランダムな長い文字列を設定)
CRON_SECRET=
