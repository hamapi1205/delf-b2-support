# Meta開発者画面で決める/取得する値。デプロイ先(Render等)の環境変数に設定する

# Webhook検証用の合言葉(自分で好きな文字列を決めて、Meta側にも同じ値を入力)
VERIFY_TOKEN=haru-musubi-webhook-2026

# Metaアプリの「アプリシークレット」(アプリ設定 > ベーシック)
APP_SECRET=

# Instagramアクセストークン(長期トークン・約60日ごとに更新が必要)
ACCESS_TOKEN=

# 自分のInstagramユーザーID(数字)
IG_USER_ID=

# Graph APIのバージョン(Meta開発者画面の表記に合わせる)
GRAPH_VERSION=v21.0

# DMの末尾に毎回付ける文(LINE誘導)。不要なら空にする
# DM_FOOTER=

# カード番号が読み取れなかったコメントへの公開返信。不要なら空にする
# FALLBACK_REPLY=
